{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.2.0"
  },
  "pages": [
    {
      "component": "root",
      "route": "medical-supply"
    }
  ],
  "extensions": [
    {
      "name": "medical-supply-dashboard-link",
      "component": "medicalSupplyDashboardLink",
      "slot": "homepage-dashboard-slot",
      "privileges": ["O3 View Medical Supply Dashboard"],
      "meta": {
        "name": "medical-supply",
        "slot": "medical-supply-dashboard-slot",
        "title": "Medical Supply"
      },
      "online": true,
      "offline": true
    },
    {
      "component": "root",
      "name": "medical-supply",
      "slot": "medical-supply-dashboard-slot",
      "privileges": ["O3 View Medical supply Dashboard"]
    },
    {
      "name": "pickup-medical-supply-request-modal",
      "component": "pickupMedicalSupplyRequestModal"
    },
    {
      "name": "reject-medical-supply-request-modal",
      "component": "rejectMedicalSupplyRequestModal"
    },
    {
      "name": "pick-medical-supply-request-action",
      "component": "pickupMedicalSupplyRequestAction",
      "slot": "medical-supply-ordered-actions-slot"
    },
    {
      "name": "generate-medical-supply-bill-request-action",
      "component": "generateBillRequestAction",
      "slot": "medical-supply-ordered-actions-slot"
    },
    {
      "name": "reject-medical-supply-request-action",
      "component": "rejectMedicalSupplyRequestAction",
      "slot": "rejected-ordered-medical-supply-actions-slot"
    },
    {
      "name": "add-medical-supply-request-results-action",
      "component": "addMedicalSupplyRequestResultsAction",
      "slot": "inprogress-medical-supply-tests-actions-slot"
    },
    {
      "name": "ordered-medical-supply-requests-table",
      "slot": "medical-supply-panels-slot",
      "order": 0,
      "component": "orderedRequestsTable",
      "meta": {
        "name": "orderedMedicalSupplyPanel",
        "title": "Medical supplies ordered"
      }
    },
    {
      "name": "inprogress-medical-supply-requests-table",
      "slot": "medical-supply-panels-slot",
      "component": "inprogressRequestsTable",
      "order": 1,
      "meta": {
        "name": "inprogressMedicalSupplyPanel",
        "title": "In progress"
      }
    },
    {
      "name": "completed-medical-supply-requests-table",
      "slot": "medical-supply-panels-slot",
      "component": "completedRequestsTable",
      "order": 2,
      "meta": {
        "name": "completedMedicalSupplyPanel",
        "title": "Completed"
      }
    },
    {
      "name": "declined-medical-supply-requests-table",
      "slot": "medical-supply-panels-slot",
      "component": "declinedRequestsTable",
      "order": 3,
      "meta": {
        "name": "declinedMedicalSupplyPanel",
        "title": "Declined"
      }
    },
    {
      "name": "ordered-medical-supply-requests-tile",
      "slot": "medical-supply-tiles-slot",
      "component": "orderedRequestsTile",
      "order": 0,
      "meta": {
        "name": "orderedRequestsTile",
        "title": "Medical Supplies ordered"
      }
    },
    {
      "name": "inprogress-medical-supply-requests-tile",
      "slot": "medical-supply-tiles-slot",
      "component": "inProgressRequestsTile",
      "order": 1,
      "meta": {
        "name": "inprogressRequestsTile",
        "title": "In progress"
      }
    },
    {
      "name": "completed-medical-supply-requests-tile",
      "slot": "medical-supply-tiles-slot",
      "component": "completedRequestsTile",
      "order": 2,
      "meta": {
        "name": "completedRequestsTile",
        "title": "Completed"
      }
    },
    {
      "name": "declined-medical-supply-requests-tile",
      "slot": "medical-supply-tiles-slot",
      "component": "declinedRequestsTile",
      "order": 3,
      "meta": {
        "name": "declinedRequestsTile",
        "title": "Declined medical supplies"
      }
    }
  ],
  "workspaces": [
    {
      "name": "post-medical-supply-form-workspace",
      "component": "postMedicalSupplyForm",
      "title": "Medical supply results",
      "type": "other-form"
    }
  ]
}